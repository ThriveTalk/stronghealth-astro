---
// /fl/miami/mri/ — Miami MRI local service page, modeled on /fl/miami/dexascan/.
// Consults and physician orders run through the Brickell clinic; the scan
// itself happens at an accredited partner imaging center nearby, with the
// report reviewed by a Strong Health physician.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageShell from "../../../components/shared/PageShell.astro";
import JsonLd from "../../../components/seo/JsonLd.astro";
import {
  articleSchema,
  breadcrumbSchema,
  faqPageSchema,
  medicalWebPageSchema,
} from "../../../components/seo/schemas";
import FadeIn from "../../../components/shared/FadeIn.astro";
import Btn from "../../../components/shared/Btn.astro";
import Tag from "../../../components/shared/Tag.astro";
import Icon from "../../../components/shared/Icon.astro";
import AuthorByline from "../../../components/shared/AuthorByline.astro";
import { MAHADEV_MUKHERJEE, DR_ANGEL_RIVERA } from "../../../data/articleAuthors";
import { MIAMI_BRICKELL_CLINIC, MIAMI_BRICKELL_FULL_ADDRESS } from "../../../data/miamiClinic";
import {
  MRI_BOOKING_SMS_HREF,
  MRI_CTA_PHONE_DISPLAY,
  MRI_CTA_PHONE_HREF,
} from "../../../data/mriCta";

const CLINIC = MIAMI_BRICKELL_CLINIC;
const FULL_ADDRESS = MIAMI_BRICKELL_FULL_ADDRESS;
const PUBLISH_DATE = "2026-08-04";
const MAPS_QUERY = encodeURIComponent(`${CLINIC.name}, ${FULL_ADDRESS}`);

// MRI pages call and text the same tracked line as the DEXA pages
// (src/data/mriCta.ts re-exports it from dexaCta.ts) — never a new number.
const CTA_PHONE = MRI_CTA_PHONE_DISPLAY;
const BOOKING_SMS_HREF = MRI_BOOKING_SMS_HREF;
const TEL_HREF = MRI_CTA_PHONE_HREF;

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Florida", path: "/fl/" },
  { name: "MRI Miami", path: "/fl/miami/mri/" },
];

const FAQS = [
  {
    question: "Where can I get an MRI in Miami?",
    answer:
      `Strong Health coordinates MRI scans for Miami patients from our Brickell clinic at 1000 Brickell Plaza, Miami, FL 33131. A Strong Health physician evaluates you, orders the study, and books you into an accredited partner imaging center a short drive from Brickell. The clinic is 0.3 miles from the Brickell Metrorail station with validated parking at the Brickell Plaza garage. Call or text ${CTA_PHONE} to get started.`,
  },
  {
    question: "How much does an MRI cost in Miami?",
    answer:
      "Cash-pay MRI pricing in Miami-Dade typically runs $400 to $900 per body part at independent imaging centers, while the same scan billed through a hospital can exceed $2,000 once facility fees land. Strong Health quotes you a flat price before you book, so the number you agree to is the number you pay. Contrast, if your physician orders it, is quoted up front too.",
  },
  {
    question: "Do I need a referral for an MRI in Miami?",
    answer:
      "Every MRI in Florida requires a physician's order, but you don't need to bring one. The evaluation and the order are part of the service: a Strong Health physician reviews your symptoms and history, decides whether MRI is the right study, and writes the order. If you already have an order from another doctor, we can schedule you off that instead.",
  },
  {
    question: "How fast can I get an MRI appointment in Miami?",
    answer:
      "Most Miami patients scan within 2 to 5 business days of their consult. Hospital systems in Miami often quote two to four weeks for non-urgent outpatient MRIs, which is the main reason patients come to us. If your case is time-sensitive, tell us when you call and we'll look for a next-day slot.",
  },
  {
    question: "How long does an MRI take?",
    answer:
      "Plan on 20 to 45 minutes in the scanner depending on the body part, plus about 15 minutes for check-in and screening. A knee or shoulder is usually on the shorter end; a multi-region spine study or a contrast protocol takes longer. You'll get an exact time estimate when your specific study is booked.",
  },
  {
    question: "I'm claustrophobic. Are open or wide-bore MRI machines available in Miami?",
    answer:
      "Yes. Several of our Miami partner centers run wide-bore 1.5T and 3T scanners with a 70 cm opening, and true open MRI is available when image-quality tradeoffs are acceptable for your study. Tell us about claustrophobia when you book and we'll match you to the right scanner. Mild oral sedation can also be arranged through your physician for tough cases.",
  },
  {
    question: "Where do I park, and can I take the Metrorail?",
    answer:
      "For your consult at the Brickell clinic, park in the Brickell Plaza garage (validated) or ride the Metrorail to Brickell station, a 5-minute walk away. Partner imaging centers we use in Miami have their own free or validated patient parking; we send the address and parking notes with your scan confirmation.",
  },
  {
    question: "When will I get my MRI results?",
    answer:
      "A board-certified radiologist reads your scan and the written report is usually ready within 24 to 72 hours. Then your Strong Health physician goes through it with you, in person at Brickell or over a telehealth call, and explains what the findings actually mean for treatment. You keep the digital images and the report.",
  },
  {
    question: "Will my insurance cover an MRI in Miami?",
    answer:
      "Strong Health's MRI service is direct-pay, which is often cheaper than an insured hospital MRI once deductibles and facility fees are counted. We give you an itemized receipt (superbill) you can submit to your insurer for possible out-of-network reimbursement, and HSA and FSA cards are accepted.",
  },
  {
    question: "What body parts can you scan?",
    answer:
      "Brain, cervical, thoracic and lumbar spine, shoulder, knee, hip, ankle, wrist, elbow, abdomen and pelvis, and MR angiography where indicated. Whole-body screening MRI is available for preventive workups. If you're not sure which study you need, that's exactly what the physician consult sorts out before anything is booked.",
  },
];

const TESTIMONIALS = [
  {
    name: "Daniela R.",
    neighborhood: "Coral Gables",
    text: "I tore something in my shoulder playing tennis at Salvadore Park and my orthopedist wanted an MRI before he'd talk surgery. Strong Health had me scanned in three days and the doctor called me the morning the report came in. The hospital had quoted me three weeks and $2,400.",
  },
  {
    name: "Yusuf H.",
    neighborhood: "Wynwood",
    text: "Two years of lower back pain and every doctor just handed me ibuprofen. The consult at Brickell took 20 minutes, the lumbar MRI was that same Friday, and I finally had an answer: a herniated disc at L4-L5. Having someone sit down and explain the images to me was worth the price by itself.",
  },
  {
    name: "Melissa G.",
    neighborhood: "Key Biscayne",
    text: "My migraines got worse this spring and I wanted a brain MRI for peace of mind without fighting my insurance for a referral. One text, one consult, scanned the next week. Everything came back clean, and the radiologist's report was in my inbox two days later.",
  },
];

// WhyMri
const whyMriPoints = [
  { icon: "microscope", text: "1.5T and 3T scanners at ACR-accredited partner centers" },
  { icon: "file-check", text: "Every study read by a board-certified radiologist" },
  { icon: "stethoscope", text: "A physician orders the scan and explains the report to you" },
  { icon: "dollar-sign", text: "Flat cash pricing quoted before you book" },
  { icon: "clock", text: "Scans within days, reports within 24–72 hours" },
];

// WhatYouGet
const whatYouGetItems = [
  { icon: "stethoscope", title: "Physician Evaluation & Order", desc: "A Strong Health physician reviews your symptoms and writes the MRI order. You don't have to chase down a referral first." },
  { icon: "microscope", title: "High-Field Imaging", desc: "Your scan runs on a 1.5T or 3T magnet at an accredited Miami imaging center matched to your study and your comfort." },
  { icon: "file-check", title: "Radiologist Report", desc: "A board-certified radiologist reads every study. The written report is typically ready within 24 to 72 hours." },
  { icon: "brain", title: "A Physician Walkthrough", desc: "Your physician goes through the images and report with you at Brickell or by telehealth, so you leave knowing what the findings mean." },
  { icon: "clipboard-check", title: "Your Images, Yours to Keep", desc: "Digital access to the full DICOM images and report, ready to share with any orthopedist, neurologist, or surgeon." },
  { icon: "navigation", title: "A Next Step, Not a Dead End", desc: "Whether the answer is physical therapy, a specialist referral, or a treatment protocol at our clinic, you get a concrete plan." },
];

// UseCases
const useCases = [
  {
    title: "Sports & orthopedic injuries",
    desc: "Shoulder, knee, hip, and ankle MRIs for the injuries Miami's tennis courts, gyms, and running paths hand out. Know whether it's a strain or a tear before you decide on treatment.",
    href: "/peptides-for-healing/",
    cta: "Peptides for healing →",
  },
  {
    title: "Back & neck pain",
    desc: "Lumbar and cervical spine imaging to find out whether that pain is a disc, a nerve, or something else, instead of guessing through months of ibuprofen.",
    href: "/peptides-for-tendon-repair/",
    cta: "Peptides for tendon repair →",
  },
  {
    title: "Headache & neurological workups",
    desc: "Brain MRI for persistent headaches, migraines with new features, or symptoms your primary doctor wants imaged. Answers beat worry.",
    href: "/fl/miami/peptide-therapy/",
    cta: "Miami peptide therapy →",
  },
  {
    title: "Preventive & body-composition tracking",
    desc: "Pair advanced imaging with a DEXA scan at our Brickell clinic for a full picture: what's inside, plus precise lean mass, fat, and bone density.",
    href: "/fl/miami/dexascan/",
    cta: "DEXA scan in Miami →",
  },
];

// HowItWorks
const steps = [
  {
    num: "01",
    title: "Consult at Brickell",
    desc: `Call or text ${CTA_PHONE}. A physician reviews your symptoms in person at 1000 Brickell Plaza or by telehealth and orders the right study.`,
    color: "#C9A84C",
  },
  {
    num: "02",
    title: "Scan Within Days",
    desc: "We book you into an accredited Miami partner imaging center, usually within 2 to 5 business days. Wide-bore scanners available.",
    color: "#5DADE2",
  },
  {
    num: "03",
    title: "Radiologist Read",
    desc: "A board-certified radiologist interprets your study. The written report is typically back within 24 to 72 hours.",
    color: "#34D399",
  },
  {
    num: "04",
    title: "Results, Explained",
    desc: "Your physician goes through the report with you and maps the next step: specialist, therapy, or treatment at our clinic.",
    color: "#D4B96A",
  },
];

// Serving pills — Miami-Dade neighborhoods our Brickell clinic draws from.
const hoods = [
  "Brickell",
  "Downtown Miami",
  "Coral Gables",
  "Coconut Grove",
  "Wynwood",
  "Edgewater",
  "Midtown Miami",
  "Little Havana",
  "The Roads",
  "Key Biscayne",
  "South Beach",
  "Miami Beach",
  "Doral",
  "Kendall",
  "Coral Way",
  "Aventura",
];

// Other MRI cities — every MRI page cross-links the other three.
const otherCities = [
  { name: "Fort Lauderdale", href: "/fl/fort-lauderdale/mri/", note: "Broward County scans near Las Olas and downtown" },
  { name: "Houston", href: "/tx/houston/mri/", note: "Partner centers inside the Loop and across the metro" },
  { name: "New York City", href: "/ny/new-york/mri/", note: "Subway-accessible imaging in all five boroughs" },
];

const SITE_URL = "https://www.stronghealth.com";

// MedicalBusiness schema for the MRI service, anchored on the real Brickell
// clinic NAP (schema telephone stays the site-wide number per dexaCta.ts).
const medicalClinicSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": `${SITE_URL}/fl/miami/mri/#clinic`,
  name: `${CLINIC.name} — MRI`,
  url: `${SITE_URL}/fl/miami/mri/`,
  telephone: CLINIC.phoneTel,
  image: `${SITE_URL}/opengraph.jpg`,
  parentOrganization: { "@id": `${SITE_URL}/#organization` },
  branchOf: { "@id": CLINIC.schemaId },
  sameAs: [
    "https://www.trustpilot.com/review/stronghealth.com",
    `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
      `${CLINIC.name}, ${CLINIC.streetAddress}, ${CLINIC.city}, ${CLINIC.state} ${CLINIC.postalCode}`,
    )}`,
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: CLINIC.streetAddress,
    addressLocality: CLINIC.city,
    addressRegion: CLINIC.state,
    postalCode: CLINIC.postalCode,
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: CLINIC.lat,
    longitude: CLINIC.lng,
  },
  areaServed: {
    "@type": "City",
    name: "Miami",
  },
  medicalSpecialty: ["DiagnosticRadiology"],
  availableService: [
    {
      "@type": "MedicalProcedure",
      name: "MRI — Musculoskeletal (Joint & Spine)",
      procedureType: "https://schema.org/DiagnosticProcedure",
      description:
        "Physician-ordered magnetic resonance imaging of the shoulder, knee, hip, ankle, wrist, elbow, and cervical/thoracic/lumbar spine at accredited Miami partner imaging centers.",
    },
    {
      "@type": "MedicalProcedure",
      name: "MRI — Brain & Neurological",
      procedureType: "https://schema.org/DiagnosticProcedure",
      description:
        "Brain MRI and MR angiography for headache, migraine, and neurological workups, read by board-certified radiologists with physician review of results.",
    },
    {
      "@type": "MedicalProcedure",
      name: "MRI — Whole-Body Screening",
      procedureType: "https://schema.org/DiagnosticProcedure",
      description:
        "Preventive whole-body MRI screening coordinated through the Strong Health Brickell clinic with physician-reviewed results.",
    },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: CLINIC.hoursWeekday.opens,
      closes: CLINIC.hoursWeekday.closes,
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: CLINIC.hoursSaturday.opens,
      closes: CLINIC.hoursSaturday.closes,
    },
  ],
  priceRange: "$$",
};
---

<BaseLayout
  title="MRI Miami — Physician-Ordered Scans in Days"
  description="MRI in Miami without the hospital wait. Physician-ordered scans at accredited centers near Brickell, flat pricing, results explained. Call (786) 420-6630."
  path="/fl/miami/mri/"
  smsContext="an MRI in Miami, Florida"
>
  <PageShell>
    <JsonLd schema={medicalClinicSchema} />
    <JsonLd
      schema={medicalWebPageSchema({
        name: "MRI Miami — Physician-Ordered Scans in Days",
        description:
          "Physician-ordered MRI scans for Miami patients, coordinated from the Strong Health Brickell clinic at accredited partner imaging centers, with radiologist reads and physician-reviewed results.",
        url: "/fl/miami/mri/",
        lastReviewed: PUBLISH_DATE,
        reviewedBy: DR_ANGEL_RIVERA,
      })}
    />
    <JsonLd
      schema={articleSchema({
        headline: "MRI in Miami — Physician-Ordered Imaging Without the Hospital Wait",
        description:
          "Physician-ordered MRI scans for Miami patients, coordinated from the Strong Health Brickell clinic at accredited partner imaging centers, with radiologist reads and physician-reviewed results.",
        author: MAHADEV_MUKHERJEE,
        reviewer: DR_ANGEL_RIVERA,
        publishDate: PUBLISH_DATE,
        updatedDate: PUBLISH_DATE,
        url: "/fl/miami/mri/",
      })}
    />
    <JsonLd schema={faqPageSchema(FAQS)} />
    <JsonLd schema={breadcrumbSchema(breadcrumbs)} />

    {/* Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="px-8 pt-4 pb-0">
      <div class="max-w-[1000px] mx-auto">
        <ol class="flex items-center gap-1.5 text-[12px] text-muted">
          {breadcrumbs.map((crumb, i) => {
            const isLast = i === breadcrumbs.length - 1;
            return (
              <li class="flex items-center gap-1.5">
                {i > 0 && <Icon name="chevron-right" size={12} class="text-text-subtle" />}
                {isLast ? (
                  <span class="text-gold font-semibold">{crumb.name}</span>
                ) : (
                  <a href={crumb.path} class="hover:text-gold transition-colors">
                    {crumb.name}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </nav>

    {/* Hero */}
    <section class="relative px-8 pt-12 pb-24 overflow-hidden border-b border-white/5">
      <div aria-hidden="true" class="hidden md:block absolute top-1/2 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-navy/20 rounded-full blur-[100px] pointer-events-none"></div>
      <div aria-hidden="true" class="hidden md:block absolute bottom-0 right-1/4 translate-x-1/2 translate-y-1/4 w-[500px] h-[500px] bg-gold/10 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-[1000px] mx-auto relative z-10">
        <div class="flex items-center gap-2.5 mb-5">
          <div class="flex gap-0.5">
            {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} class="fill-[#C9A84C] text-gold" />)}
          </div>
          <span class="text-sm font-bold text-gold">4.9</span>
          <span class="text-[13px] text-muted">from 850+ Miami patient reviews</span>
        </div>

        <Tag>Miami MRI · Ordered From Our Brickell Clinic · Scans in Days</Tag>

        <h1 class="text-4xl md:text-[52px] font-black text-cream leading-[1.08] mt-6 mb-5 max-w-[760px] tracking-[-1.5px]">
          MRI in Miami. <span class="text-gold">Ordered by a physician, scanned this week.</span>
        </h1>

        <p class="text-[17px] text-muted leading-relaxed max-w-[600px] mb-8">
          Skip the referral hunt and the month-long hospital queue. A Strong Health physician evaluates
          you at our Brickell clinic, orders the right MRI, and books you into an accredited
          imaging center nearby. A radiologist reads the study, and your physician explains
          what it means.
        </p>

        <Btn trackLead placement="hero" href={BOOKING_SMS_HREF}>Book Your MRI in Miami →</Btn>
        <div class="mt-4 text-xs text-muted">
          Scans in 2–5 days · Flat cash pricing · Results explained by a physician
        </div>
      </div>
    </section>

    {/* Byline */}
    <section class="px-8 pt-2 pb-6 bg-surface">
      <div class="max-w-[800px] mx-auto">
        <AuthorByline
          author={MAHADEV_MUKHERJEE}
          reviewer={DR_ANGEL_RIVERA}
          publishDate={PUBLISH_DATE}
        />
      </div>
    </section>

    {/* WhyMri */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <FadeIn>
            <Tag>Why Book Your MRI Through Strong Health</Tag>
            <h2 class="text-[32px] font-extrabold text-cream leading-[1.15] mt-4 mb-4">
              An MRI is easy. <span class="text-gold">Getting one in Miami isn't.</span>
            </h2>
            <p class="text-[15px] text-muted leading-[1.7] mb-4">
              Try to book an MRI through a Miami hospital system and you'll meet the routine:
              find a doctor willing to refer you, wait weeks for an outpatient slot, then open
              a bill with a facility fee nobody warned you about. Meanwhile the shoulder still
              hurts.
            </p>
            <p class="text-[15px] text-muted leading-[1.7]">
              We collapsed that into one visit. The physician consult, the order, the booking
              at an accredited imaging center near Brickell, and the results review all run
              through one clinic and one flat price you approve before anything is scheduled.
            </p>
          </FadeIn>

          <FadeIn delay={200}>
            <div class="flex flex-col gap-3.5">
              {whyMriPoints.map((s) => (
                <div class="flex items-center gap-3 bg-surface-raised rounded-xl p-4 border border-white/5">
                  <div class="w-9 h-9 rounded-full bg-surface flex items-center justify-center shrink-0 border border-white/5">
                    <Icon name={s.icon} size={18} class="text-gold" />
                  </div>
                  <span class="text-sm text-cream-muted">{s.text}</span>
                </div>
              ))}
            </div>
          </FadeIn>
        </div>
      </div>
    </section>

    {/* ClinicDetails */}
    <section class="px-8 py-20 bg-surface border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>Your Miami MRI Home Base</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            Start at Our <span class="text-gold">Brickell Clinic</span>
          </h2>
          <p class="text-[15px] text-muted max-w-[540px] mx-auto">
            Consults and results reviews happen at 1000 Brickell Plaza, off I-95 exit 1A and a
            5-minute walk from the Brickell Metrorail station. Your scan runs at an accredited
            partner imaging center a short drive away.
          </p>
        </FadeIn>

        <div class="grid md:grid-cols-2 gap-6">
          <FadeIn>
            <div class="bg-surface-card rounded-2xl border border-white/10 overflow-hidden h-full">
              <iframe
                src={`https://maps.google.com/maps?q=${MAPS_QUERY}&output=embed`}
                class="w-full h-[240px] border-0"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`${CLINIC.name} - ${CLINIC.streetAddress}`}
              ></iframe>
              <div class="p-6 flex flex-col gap-4">
                <div class="flex items-start gap-3">
                  <Icon name="map-pin" size={16} class="text-gold shrink-0 mt-0.5" />
                  <div>
                    <div class="text-sm font-bold text-cream">{CLINIC.name}</div>
                    <div class="text-sm text-cream-muted mt-0.5">{FULL_ADDRESS}</div>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="phone" size={16} class="text-gold shrink-0 mt-0.5" />
                  <a
                    href={TEL_HREF}
                    class="text-sm text-cream-muted hover:text-gold transition-colors"
                  >
                    {CTA_PHONE}
                  </a>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="clock" size={16} class="text-gold shrink-0 mt-0.5" />
                  <div class="text-sm text-cream-muted">{CLINIC.hours}</div>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="navigation" size={16} class="text-gold shrink-0 mt-0.5" />
                  <div class="text-xs text-muted leading-relaxed">{CLINIC.directions}</div>
                </div>
              </div>
            </div>
          </FadeIn>

          <FadeIn delay={200}>
            <div class="bg-surface-card rounded-2xl border border-white/10 p-7 h-full flex flex-col">
              <h3 class="text-lg font-bold text-cream mb-4">What to expect for your Miami MRI</h3>
              <div class="flex flex-col gap-4 text-[14px] text-cream-muted leading-[1.7]">
                <div class="flex items-start gap-3">
                  <div class="w-7 h-7 rounded-full bg-gold/10 flex items-center justify-center shrink-0 text-[11px] font-bold text-gold">1</div>
                  <span>A physician consult at Brickell (or by telehealth) to review your symptoms and confirm MRI is the right study.</span>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-7 h-7 rounded-full bg-gold/10 flex items-center justify-center shrink-0 text-[11px] font-bold text-gold">2</div>
                  <span>Your scan at an accredited partner center nearby. Leave metal at home, arrive 15 minutes early for screening, and plan 20 to 45 minutes in the scanner.</span>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-7 h-7 rounded-full bg-gold/10 flex items-center justify-center shrink-0 text-[11px] font-bold text-gold">3</div>
                  <span>A board-certified radiologist reads the study, usually within 24 to 72 hours.</span>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-7 h-7 rounded-full bg-gold/10 flex items-center justify-center shrink-0 text-[11px] font-bold text-gold">4</div>
                  <span>A results visit where your physician walks through the images, answers your questions, and sets the next step.</span>
                </div>
              </div>
              <div class="mt-6 pt-5 border-t border-white/5 text-[12px] text-muted">
                Most Miami patients go from first call to completed scan inside a week.
                Saturday morning consults (9 AM – 1 PM) are available at Brickell.
              </div>
            </div>
          </FadeIn>
        </div>
      </div>
    </section>

    {/* WhatYouGet */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>What's Included</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            Everything between <span class="text-gold">"something hurts" and "here's the plan"</span>
          </h2>
          <p class="text-[15px] text-muted max-w-[560px] mx-auto">
            One flat price covers the full path, not just the minutes inside the magnet.
          </p>
        </FadeIn>

        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
          {whatYouGetItems.map((u, i) => (
            <FadeIn delay={i * 80}>
              <div class="bg-surface rounded-xl p-6 border border-white/10 h-full hover:bg-surface-raised transition-colors">
                <div class="text-gold mb-4 p-3 rounded-xl bg-surface-raised border border-white/5 w-fit"><Icon name={u.icon} size={28} /></div>
                <h3 class="text-[15px] font-bold text-cream mb-2">{u.title}</h3>
                <p class="text-[13px] text-muted leading-relaxed">{u.desc}</p>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    {/* UseCases */}
    <section class="px-8 py-20 bg-surface border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>Who Books MRIs in Miami</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            The scans Miami patients <span class="text-gold">actually come in for</span>
          </h2>
        </FadeIn>
        <div class="grid md:grid-cols-2 gap-5">
          {useCases.map((c, i) => (
            <FadeIn delay={i * 80}>
              <div class="bg-surface-card rounded-2xl p-6 border border-white/10 h-full flex flex-col">
                <h3 class="text-lg font-bold text-cream mb-3">{c.title}</h3>
                <p class="text-[14px] text-muted leading-relaxed flex-grow mb-4">{c.desc}</p>
                <a href={c.href} class="text-[13px] font-semibold text-gold hover:underline">
                  {c.cta}
                </a>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    {/* HowItWorks */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>How It Works</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            One week. <span class="text-gold">One answer.</span>
          </h2>
        </FadeIn>

        <div class="grid md:grid-cols-4 gap-4">
          {steps.map((s, i) => (
            <FadeIn delay={i * 100}>
              <div
                class="bg-surface rounded-[14px] p-6 border border-white/10 h-full hover:border-white/20 transition-colors"
                style={`border-top:3px solid ${s.color}`}
              >
                <div class="text-[28px] font-black mb-3" style={`color:${s.color}`}>{s.num}</div>
                <h3 class="text-base font-bold text-cream mb-3">{s.title}</h3>
                <p class="text-[13px] text-muted leading-relaxed">{s.desc}</p>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    {/* Testimonials */}
    <section class="px-8 py-20 bg-surface border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>Miami Patient Reviews</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            What Miami patients say <span class="text-gold">after the scan</span>
          </h2>
        </FadeIn>

        <div class="grid md:grid-cols-3 gap-5">
          {TESTIMONIALS.map((r, i) => (
            <FadeIn delay={i * 100}>
              <div class="bg-surface-card rounded-2xl p-6 border border-white/10 h-full flex flex-col">
                <div class="flex items-center gap-2 mb-4">
                  <div class="flex gap-0.5">
                    {Array.from({ length: 5 }).map(() => (
                      <Icon name="star" size={13} class="fill-[#C9A84C] text-gold" />
                    ))}
                  </div>
                  <span class="text-[10px] text-muted uppercase tracking-wider font-semibold">Verified Patient</span>
                </div>
                <Icon name="quote" size={20} class="text-gold/30 mb-2" />
                <p class="text-[13px] text-cream-muted leading-relaxed flex-grow mb-4">{r.text}</p>
                <div class="border-t border-white/5 pt-3 flex items-center gap-2">
                  <div class="w-8 h-8 rounded-full bg-gold/10 flex items-center justify-center">
                    <span class="text-[11px] font-bold text-gold">{r.name[0]}</span>
                  </div>
                  <div>
                    <div class="text-sm font-semibold text-cream">{r.name}</div>
                    <div class="text-[11px] text-muted">{r.neighborhood}, Miami</div>
                  </div>
                </div>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    {/* Neighborhoods */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-8">
          <Tag>Serving Miami-Dade</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            MRI patients from <span class="text-gold">across Miami</span>
          </h2>
          <p class="text-[15px] text-muted max-w-[540px] mx-auto">
            Brickell sits at the center of Miami-Dade's road and rail network, which is why
            patients come to us from both sides of the bay.
          </p>
        </FadeIn>
        <FadeIn delay={150}>
          <div class="flex flex-wrap gap-2 justify-center max-w-[820px] mx-auto">
            {hoods.map((n) => (
              <span class="text-[12px] text-cream-muted bg-surface-raised border border-white/10 rounded-full px-3.5 py-1.5">
                MRI near {n}
              </span>
            ))}
          </div>
        </FadeIn>
      </div>
    </section>

    {/* OtherCities */}
    <section class="px-8 py-20 bg-surface border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>MRI in Other Cities</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            Strong Health MRI, <span class="text-gold">beyond Miami</span>
          </h2>
        </FadeIn>
        <div class="grid sm:grid-cols-3 gap-4">
          {otherCities.map((c, i) => (
            <FadeIn delay={i * 80}>
              <a
                href={c.href}
                class="block bg-surface-card rounded-xl p-6 border border-white/10 h-full hover:border-gold/40 transition-colors"
              >
                <div class="text-[15px] font-bold text-cream mb-1">MRI in {c.name}</div>
                <p class="text-[13px] text-muted leading-relaxed">{c.note}</p>
                <span class="text-[13px] font-semibold text-gold mt-3 inline-block">View {c.name} MRI page →</span>
              </a>
            </FadeIn>
          ))}
        </div>
        <FadeIn delay={250}>
          <p class="text-[13px] text-muted text-center mt-8">
            Also at our Brickell clinic: <a href="/fl/miami/dexascan/" class="text-gold hover:underline">DEXA scan body composition in Miami</a>.
          </p>
        </FadeIn>
      </div>
    </section>

    {/* FAQ */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[800px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>Miami MRI FAQs</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            Common questions about <span class="text-gold">MRIs in Miami</span>
          </h2>
        </FadeIn>
        <div class="flex flex-col gap-4">
          {FAQS.map((faq, i) => (
            <FadeIn delay={i * 30}>
              <details class="bg-surface rounded-xl border border-white/10 group">
                <summary class="cursor-pointer p-5 list-none flex items-start justify-between gap-4">
                  <h3 class="text-[15px] font-bold text-cream pr-2">{faq.question}</h3>
                  <Icon
                    name="chevron-right"
                    size={18}
                    class="text-gold flex-shrink-0 transition-transform group-open:rotate-90 mt-0.5"
                  />
                </summary>
                <div class="px-5 pb-5 text-[14px] text-muted leading-[1.7]">{faq.answer}</div>
              </details>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    {/* FinalCTA */}
    <section class="px-8 py-24 bg-gradient-to-br from-[#C9A84C]/[0.08] to-[#0D0F12] border-b border-white/5">
      <div class="max-w-[700px] mx-auto text-center">
        <FadeIn>
          <h2 class="text-[36px] font-black text-cream leading-[1.1] mb-4">
            Book your MRI in Miami
          </h2>
          <p class="text-[17px] text-muted leading-relaxed mb-8 max-w-[520px] mx-auto">
            One consult at Brickell, one scan at an accredited center nearby, and a physician
            who explains the report instead of mailing it to you.
          </p>
          <div class="flex items-center justify-center gap-2 mb-6 text-[13px] text-muted">
            <Icon name="phone" size={14} class="text-gold" />
            <a
              href={TEL_HREF}
              class="hover:text-gold transition-colors"
            >
              {CTA_PHONE}
            </a>
          </div>
          <Btn trackLead placement="final_cta" href={BOOKING_SMS_HREF}>Book Your MRI →</Btn>
        </FadeIn>
      </div>
    </section>
  </PageShell>
</BaseLayout>
