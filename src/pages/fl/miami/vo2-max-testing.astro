---
// /fl/miami/vo2-max-testing/ — hyper-localized Miami VO2 max testing page.
// Self-contained (like the Miami DEXA page): reuses the shared component
// system + JsonLd schema builders. Targets the "vo2 max test miami" /
// "vo2 max testing near me" local cluster; build plan in
// docs/briefs/vo2-max-testing-miami.md.
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageShell from "../../../components/shared/PageShell.astro";
import JsonLd from "../../../components/seo/JsonLd.astro";
import {
  articleSchema,
  breadcrumbSchema,
  faqPageSchema,
  medicalWebPageSchema,
} from "../../../components/seo/schemas";
import FadeIn from "../../../components/shared/FadeIn.astro";
import Btn from "../../../components/shared/Btn.astro";
import Tag from "../../../components/shared/Tag.astro";
import Icon from "../../../components/shared/Icon.astro";
import AuthorByline from "../../../components/shared/AuthorByline.astro";
import { MAHADEV_MUKHERJEE, DR_ANGEL_RIVERA } from "../../../data/articleAuthors";
import { MIAMI_BRICKELL_CLINIC, MIAMI_BRICKELL_FULL_ADDRESS } from "../../../data/miamiClinic";
import { MIAMI_DEXA_NEIGHBORHOODS } from "../../../data/local/dexaNeighborhoods";

const CLINIC = MIAMI_BRICKELL_CLINIC;
const FULL_ADDRESS = MIAMI_BRICKELL_FULL_ADDRESS;
const PUBLISH_DATE = "2026-08-05";
const MAPS_QUERY = encodeURIComponent(`${CLINIC.name}, ${FULL_ADDRESS}`);

const BOOKING_SMS_NUMBER = "+17542636026";
const BOOKING_SMS_BODY = "I would like to book a VO2 Max test with Strong Health";
// Use the "?&body=" form so the pre-filled message works on both iOS and Android.
const BOOKING_SMS_HREF = `sms:${BOOKING_SMS_NUMBER}?&body=${encodeURIComponent(
  BOOKING_SMS_BODY,
)}`;

const TEL_HREF = `tel:${CLINIC.phone.replace(/[^\d+]/g, "")}`;
const PAGE_PATH = "/fl/miami/vo2-max-testing/";
const SITE_URL = "https://www.stronghealth.com";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Florida", path: "/fl/" },
  { name: "VO2 Max Testing Miami", path: PAGE_PATH },
];

const FAQS = [
  {
    question: "Where can I get a VO2 max test in Miami?",
    answer:
      "Strong Health offers physician-supervised VO2 max testing at our Brickell clinic at 1000 Brickell Plaza, Miami, FL 33131. We're centrally located in Miami's financial district with validated parking and Metrorail access (Brickell station, 0.3 mi). Same-week appointments are typically available. Call (754) 263-6026 to book.",
  },
  {
    question: "How much does a VO2 max test cost in Miami?",
    answer:
      "VO2 max testing at our Miami clinic uses transparent direct-pay pricing with no hidden fees — no insurance runaround, no surprise charges. Bundled pricing is available if you pair the test with a DEXA scan or plan to re-test over the year to track training progress. Call (754) 263-6026 for current rates and bundle options.",
  },
  {
    question: "What does a VO2 max test measure?",
    answer:
      "VO2 max is the maximum rate at which your body can take in and use oxygen during exercise, measured in milliliters of oxygen per kilogram of body weight per minute (ml/kg/min). During the test, a metabolic cart analyzes every breath you take to measure it directly. Your report also includes your ventilatory thresholds (VT1 and VT2), personalized heart-rate training zones, and your fitness percentile for your age and sex.",
  },
  {
    question: "How accurate is a VO2 max test vs. my Apple Watch or Garmin?",
    answer:
      "Wearables estimate VO2 max from heart rate and pace data, and those estimates can be off by 10% or more — often flattering you. A clinical VO2 max test measures your actual oxygen consumption breath by breath with a metabolic cart, which is the gold standard used in exercise physiology labs. It's the difference between a guess and a measurement.",
  },
  {
    question: "How long does a VO2 max test take at your Brickell clinic?",
    answer:
      "The graded ramp portion of the test takes 10–15 minutes. Plan for about 45 minutes total at our Brickell location, including check-in, a resting baseline, mask fitting, the test itself, cool-down, and a results review where we walk through your VO2 max, thresholds, and training zones before you leave.",
  },
  {
    question: "How should I prepare for a VO2 max test?",
    answer:
      "Arrive rested: skip hard training for 24 hours before the test, avoid caffeine for 3 hours, and don't eat a large meal within 2–3 hours. Wear athletic clothing and running shoes, and hydrate normally — especially important in Miami heat. If you re-test later, repeating the same conditions gives you the most reliable comparison.",
  },
  {
    question: "Do I need to be fit to take a VO2 max test? Is it safe?",
    answer:
      "You don't need to be an athlete. The protocol is graded — it starts easy and ramps up gradually to your maximum, whatever that is today — and it's physician-supervised with a health screening beforehand. You can stop at any point. Many of our Miami patients book their first test specifically because they're just starting a training or weight loss program and want a baseline.",
  },
  {
    question: "What is a good VO2 max for my age?",
    answer:
      "VO2 max norms depend on age and sex. As a rough guide, an average 40-year-old man measures in the mid-30s to low-40s ml/kg/min and a 40-year-old woman in the low-30s, while trained endurance athletes commonly measure in the 50s and 60s. Your Strong Health report places your result in a percentile for your age and sex cohort, so you know exactly where you stand and what to aim for.",
  },
  {
    question: "Can I do a VO2 max test and a DEXA scan on the same visit?",
    answer:
      "Yes — and it's the combination we recommend. A DEXA scan tells you what your body is made of (lean mass, fat mass, bone density), and a VO2 max test tells you what your engine can do. Together they're the most complete fitness and longevity baseline available at our Miami clinic. Book both in a single Brickell visit and re-test on the same schedule to track real change.",
  },
  {
    question: "How often should I re-test my VO2 max?",
    answer:
      "Every 4–6 months is ideal if you're actively training or on a protocol aimed at improving fitness — that's enough time for structured zone training to move the number meaningfully. For general health monitoring, once a year is sufficient. Re-testing at the same Miami clinic on the same equipment gives you the most reliable trend data.",
  },
];

const TESTIMONIALS = [
  {
    name: "Daniel R.",
    neighborhood: "Brickell",
    text: "Training for the Miami Marathon, my watch had my VO2 max at 52. The lab test at Strong Health measured 47 — and more importantly gave me real thresholds. I rebuilt my zones around VT2 and my long runs finally stopped falling apart at mile 16.",
  },
  {
    name: "Melissa G.",
    neighborhood: "Coral Gables",
    text: "Running in Miami heat, I was always guessing at effort. Knowing my actual thresholds changed everything — I slowed my easy days down, sped my interval days up, and my half-marathon time dropped six minutes in one season.",
  },
  {
    name: "Javier S.",
    neighborhood: "Coconut Grove",
    text: "I ride the Rickenbacker three mornings a week. After the test I started doing my causeway intervals right at VT2 instead of just hammering. Re-tested five months later: VO2 max up four points. Data beats guessing.",
  },
];

// WhyVo2Max
const whyVo2Points = [
  { icon: "chart-line", text: "Direct breath-by-breath measurement, not a wrist estimate" },
  { icon: "activity", text: "Ventilatory thresholds (VT1 & VT2) for precise zone training" },
  { icon: "trending-up", text: "Percentile ranking vs. your age and sex cohort" },
  { icon: "stethoscope", text: "Physician-supervised, graded protocol — safe at any fitness level" },
  { icon: "heart-pulse", text: "Repeatable every 4–6 months for real trend data" },
];

// WhatYouGet
const whatYouGetItems = [
  { icon: "heart-pulse", title: "Your VO2 Max Score", desc: "Measured directly in ml/kg/min (plus METs) — the single strongest fitness predictor of long-term health and longevity." },
  { icon: "trending-up", title: "Age & Sex Percentile", desc: "See exactly where you rank against your cohort — your \"fitness age\" — and what moving up a bracket would take." },
  { icon: "activity", title: "Ventilatory Thresholds", desc: "VT1 and VT2, the two physiological breakpoints that define easy, steady, and hard effort for your body specifically." },
  { icon: "zap", title: "Personal Training Zones", desc: "Heart-rate zones 1–5 anchored to your measured thresholds — not a generic 220-minus-age formula." },
  { icon: "flask-conical", title: "Fuel Utilization", desc: "Calorie burn and your fat-vs-carbohydrate crossover point, so you know what your body actually burns at each intensity." },
  { icon: "clipboard-check", title: "Trend Tracking", desc: "Side-by-side comparison reports across re-tests, so you can see your engine improving over months and years." },
];

// UseCases
const useCases = [
  {
    title: "Runners, cyclists & triathletes",
    desc: "Training for the Miami Marathon, riding the Rickenbacker, or racing on Key Biscayne? Anchor your zones to measured thresholds and stop guessing at pace in the heat.",
    href: "/fl/miami/dexascan/",
    cta: "Pair it with a DEXA scan →",
  },
  {
    title: "Longevity & healthspan",
    desc: "VO2 max is one of the strongest known predictors of long-term health and all-cause mortality. Baseline it, then train it up deliberately as part of a physician-supervised plan.",
    href: "/fl/miami/peptide-therapy/",
    cta: "Miami peptide therapy →",
  },
  {
    title: "GLP-1 & weight loss",
    desc: "Losing weight on semaglutide or tirzepatide? Verify your cardio fitness is improving as the scale drops — not just your body weight.",
    href: "/peptides-for-weight-loss/",
    cta: "Peptides for weight loss →",
  },
  {
    title: "Energy & performance protocols",
    desc: "Starting a peptide or hormone protocol aimed at energy and performance? Measure your aerobic capacity before and after so results are proven, not assumed.",
    href: "/peptides-for-energy/",
    cta: "Peptides for energy →",
  },
];

// HowItWorks
const steps = [
  {
    num: "01",
    title: "Book Your Miami Test",
    desc: "Reserve a time online or call (754) 263-6026. Same-week appointments are typically available at our Brickell clinic.",
    color: "#C9A84C",
  },
  {
    num: "02",
    title: "The 10–15 Minute Ramp",
    desc: "Treadmill or bike, mask on, effort ramps gradually from easy to your max while the metabolic cart measures every breath.",
    color: "#5DADE2",
  },
  {
    num: "03",
    title: "Same-Day Results Review",
    desc: "Walk out knowing your VO2 max, your thresholds, and your personalized heart-rate training zones.",
    color: "#34D399",
  },
  {
    num: "04",
    title: "Re-Test & Track",
    desc: "Re-test every 4–6 months while training or on a protocol. Side-by-side reports show your engine getting bigger.",
    color: "#D4B96A",
  },
];

// Neighborhood pills are intentionally NOT links: VO2 max neighborhood child
// pages don't exist yet (see docs/briefs/vo2-max-testing-miami.md §9).
const hoods = MIAMI_DEXA_NEIGHBORHOODS;

// MedicalBusiness schema — same shape/key order as the Miami DEXA page.
const medicalClinicSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": `${SITE_URL}${PAGE_PATH}#clinic`,
  name: `${CLINIC.name} — VO2 Max Testing`,
  url: `${SITE_URL}${PAGE_PATH}`,
  telephone: CLINIC.phoneTel,
  image: `${SITE_URL}/opengraph.jpg`,
  parentOrganization: { "@id": `${SITE_URL}/#organization` },
  branchOf: { "@id": CLINIC.schemaId },
  sameAs: [
    "https://www.trustpilot.com/review/stronghealth.com",
    `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
      `${CLINIC.name}, ${CLINIC.streetAddress}, ${CLINIC.city}, ${CLINIC.state} ${CLINIC.postalCode}`,
    )}`,
  ],
  address: {
    "@type": "PostalAddress",
    streetAddress: CLINIC.streetAddress,
    addressLocality: CLINIC.city,
    addressRegion: CLINIC.state,
    postalCode: CLINIC.postalCode,
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: CLINIC.lat,
    longitude: CLINIC.lng,
  },
  areaServed: {
    "@type": "City",
    name: "Miami",
  },
  medicalSpecialty: ["Cardiovascular", "PreventiveMedicine"],
  availableService: [
    {
      "@type": "MedicalProcedure",
      name: "VO2 Max Test — Cardiorespiratory Fitness Assessment",
      procedureType: "https://schema.org/DiagnosticProcedure",
      description:
        "Physician-supervised graded exercise test with breath-by-breath metabolic gas-exchange analysis. Measures VO2 max, ventilatory thresholds (VT1/VT2), and personalized heart-rate training zones.",
    },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: CLINIC.hoursWeekday.opens,
      closes: CLINIC.hoursWeekday.closes,
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: CLINIC.hoursSaturday.opens,
      closes: CLINIC.hoursSaturday.closes,
    },
  ],
  priceRange: "$",
};
---

<BaseLayout
  title="VO2 Max Testing Miami — Cardio Fitness Test"
  description="Clinical VO2 max test in Miami at our Brickell clinic. Measure your cardiorespiratory fitness, training zones & metabolic health. Same-week appointments."
  path={PAGE_PATH}
>
  <PageShell>
    <JsonLd schema={medicalClinicSchema} />
    <JsonLd
      schema={medicalWebPageSchema({
        name: "VO2 Max Testing Miami — Cardio Fitness Test",
        description:
          "Physician-supervised VO2 max testing in Miami at our Brickell clinic. Cardiorespiratory fitness, ventilatory thresholds, and personalized heart-rate training zones.",
        url: PAGE_PATH,
        lastReviewed: PUBLISH_DATE,
        reviewedBy: DR_ANGEL_RIVERA,
      })}
    />
    <JsonLd
      schema={articleSchema({
        headline: "VO2 Max Testing Miami — Cardiorespiratory Fitness & Training Zones",
        description:
          "Physician-supervised VO2 max testing in Miami at our Brickell clinic. Cardiorespiratory fitness, ventilatory thresholds, and personalized heart-rate training zones.",
        author: MAHADEV_MUKHERJEE,
        reviewer: DR_ANGEL_RIVERA,
        publishDate: PUBLISH_DATE,
        updatedDate: PUBLISH_DATE,
        url: PAGE_PATH,
      })}
    />
    <JsonLd schema={faqPageSchema(FAQS)} />
    <JsonLd schema={breadcrumbSchema(breadcrumbs)} />

    {/* Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="px-8 pt-4 pb-0">
      <div class="max-w-[1000px] mx-auto">
        <ol class="flex items-center gap-1.5 text-[12px] text-muted">
          {breadcrumbs.map((crumb, i) => {
            const isLast = i === breadcrumbs.length - 1;
            return (
              <li class="flex items-center gap-1.5">
                {i > 0 && <Icon name="chevron-right" size={12} class="text-text-subtle" />}
                {isLast ? (
                  <span class="text-gold font-semibold">{crumb.name}</span>
                ) : (
                  <a href={crumb.path} class="hover:text-gold transition-colors">
                    {crumb.name}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </nav>

    {/* Hero */}
    <section class="relative px-8 pt-12 pb-24 overflow-hidden border-b border-white/5">
      <div aria-hidden="true" class="hidden md:block absolute top-1/2 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-navy/20 rounded-full blur-[100px] pointer-events-none"></div>
      <div aria-hidden="true" class="hidden md:block absolute bottom-0 right-1/4 translate-x-1/2 translate-y-1/4 w-[500px] h-[500px] bg-gold/10 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-[1000px] mx-auto relative z-10">
        <div class="flex items-center gap-2.5 mb-5">
          <div class="flex gap-0.5">
            {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} class="fill-[#C9A84C] text-gold" />)}
          </div>
          <span class="text-sm font-bold text-gold">4.9</span>
          <span class="text-[13px] text-muted">from 850+ Miami patient reviews</span>
        </div>

        <Tag>Miami VO2 Max Testing · Brickell Clinic · Same-Week Appointments</Tag>

        <h1 class="text-4xl md:text-[52px] font-black text-cream leading-[1.08] mt-6 mb-5 max-w-[760px] tracking-[-1.5px]">
          VO2 Max Testing in Miami. <span class="text-gold">Know your engine. Train with real numbers.</span>
        </h1>

        <p class="text-[17px] text-muted leading-relaxed max-w-[600px] mb-8">
          Get a physician-supervised VO2 max test in Miami, FL at our Brickell clinic. A
          metabolic cart measures your aerobic capacity breath by breath — your true VO2 max,
          your ventilatory thresholds, and heart-rate training zones built for your
          physiology, not a formula.
        </p>

        <Btn trackLead placement="hero" href={BOOKING_SMS_HREF}>Book Your VO2 Max Test in Miami →</Btn>
        <div class="mt-4 text-xs text-muted">
          45-min visit · Same-week appointments · No referral needed
        </div>
      </div>
    </section>

    {/* Byline */}
    <section class="px-8 pt-2 pb-6 bg-surface">
      <div class="max-w-[800px] mx-auto">
        <AuthorByline
          author={MAHADEV_MUKHERJEE}
          reviewer={DR_ANGEL_RIVERA}
          publishDate={PUBLISH_DATE}
        />
      </div>
    </section>

    {/* WhyVo2Max */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <FadeIn>
            <Tag>Why VO2 Max in Miami</Tag>
            <h2 class="text-[32px] font-extrabold text-cream leading-[1.15] mt-4 mb-4">
              Your watch estimates. <span class="text-gold">A lab test measures.</span>
            </h2>
            <p class="text-[15px] text-muted leading-[1.7] mb-4">
              Every Miami runner and cyclist has a VO2 max number on their wrist — and most
              of those numbers are off by 10% or more. Wearables guess from heart rate and
              pace. A clinical test measures the oxygen you actually use, breath by breath.
            </p>
            <p class="text-[15px] text-muted leading-[1.7]">
              VO2 max is also one of the strongest known predictors of long-term health and
              all-cause mortality. At Strong Health Miami, you get the same graded exercise
              protocol used in exercise physiology labs, performed at our Brickell clinic,
              with results you can train on the same day.
            </p>
          </FadeIn>

          <FadeIn delay={200}>
            <div class="flex flex-col gap-3.5">
              {whyVo2Points.map((s) => (
                <div class="flex items-center gap-3 bg-surface-raised rounded-xl p-4 border border-white/5">
                  <div class="w-9 h-9 rounded-full bg-surface flex items-center justify-center shrink-0 border border-white/5">
                    <Icon name={s.icon} size={18} class="text-gold" />
                  </div>
                  <span class="text-sm text-cream-muted">{s.text}</span>
                </div>
              ))}
            </div>
          </FadeIn>
        </div>
      </div>
    </section>

    {/* ClinicDetails */}
    <section class="px-8 py-20 bg-surface border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>Our Miami Testing Clinic</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            Visit Us in <span class="text-gold">{CLINIC.area}</span>
          </h2>
          <p class="text-[15px] text-muted max-w-[540px] mx-auto">
            Centrally located in Miami's Brickell financial district with easy access from
            I-95, the Metrorail, and validated parking. VO2 max tests by appointment.
          </p>
        </FadeIn>

        <div class="grid md:grid-cols-2 gap-6">
          <FadeIn>
            <div class="bg-surface-card rounded-2xl border border-white/10 overflow-hidden h-full">
              <iframe
                src={`https://maps.google.com/maps?q=${MAPS_QUERY}&output=embed`}
                class="w-full h-[240px] border-0"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`${CLINIC.name} - ${CLINIC.streetAddress}`}
              ></iframe>
              <div class="p-6 flex flex-col gap-4">
                <div class="flex items-start gap-3">
                  <Icon name="map-pin" size={16} class="text-gold shrink-0 mt-0.5" />
                  <div>
                    <div class="text-sm font-bold text-cream">{CLINIC.name}</div>
                    <div class="text-sm text-cream-muted mt-0.5">{FULL_ADDRESS}</div>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="phone" size={16} class="text-gold shrink-0 mt-0.5" />
                  <a
                    href={TEL_HREF}
                    class="text-sm text-cream-muted hover:text-gold transition-colors"
                  >
                    {CLINIC.phone}
                  </a>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="clock" size={16} class="text-gold shrink-0 mt-0.5" />
                  <div class="text-sm text-cream-muted">{CLINIC.hours}</div>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="navigation" size={16} class="text-gold shrink-0 mt-0.5" />
                  <div class="text-xs text-muted leading-relaxed">{CLINIC.directions}</div>
                </div>
              </div>
            </div>
          </FadeIn>

          <FadeIn delay={200}>
            <div class="bg-surface-card rounded-2xl border border-white/10 p-7 h-full flex flex-col">
              <h3 class="text-lg font-bold text-cream mb-4">What to expect at your Miami VO2 max test</h3>
              <div class="flex flex-col gap-4 text-[14px] text-cream-muted leading-[1.7]">
                <div class="flex items-start gap-3">
                  <div class="w-7 h-7 rounded-full bg-gold/10 flex items-center justify-center shrink-0 text-[11px] font-bold text-gold">1</div>
                  <span>Check-in and a quick health screen at our Brickell front desk, then a short resting baseline. Come rested — no hard training 24 hours before, no caffeine for 3 hours.</span>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-7 h-7 rounded-full bg-gold/10 flex items-center justify-center shrink-0 text-[11px] font-bold text-gold">2</div>
                  <span>Mask fitting on the treadmill or bike ergometer. The mask connects to a metabolic cart that analyzes every breath — no needles, nothing invasive.</span>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-7 h-7 rounded-full bg-gold/10 flex items-center justify-center shrink-0 text-[11px] font-bold text-gold">3</div>
                  <span>A 10–15 minute graded ramp from easy effort to your max, physician-supervised the whole way. You can stop at any point.</span>
                </div>
                <div class="flex items-start gap-3">
                  <div class="w-7 h-7 rounded-full bg-gold/10 flex items-center justify-center shrink-0 text-[11px] font-bold text-gold">4</div>
                  <span>Cool-down and a same-day results review: your VO2 max, ventilatory thresholds, and personalized heart-rate training zones before you leave.</span>
                </div>
              </div>
              <div class="mt-6 pt-5 border-t border-white/5 text-[12px] text-muted">
                Wear athletic clothing and running shoes. Most patients are seen within 5
                business days of booking at our Brickell clinic.
              </div>
            </div>
          </FadeIn>
        </div>
      </div>
    </section>

    {/* WhatYouGet */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>Your Report</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            What you get from a <span class="text-gold">Strong Health VO2 max test</span>
          </h2>
          <p class="text-[15px] text-muted max-w-[560px] mx-auto">
            Your report goes far beyond a single number. Here's everything included with
            every VO2 max test at our Miami clinic.
          </p>
        </FadeIn>

        <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-4">
          {whatYouGetItems.map((u, i) => (
            <FadeIn delay={i * 80}>
              <div class="bg-surface rounded-xl p-6 border border-white/10 h-full hover:bg-surface-raised transition-colors">
                <div class="text-gold mb-4 p-3 rounded-xl bg-surface-raised border border-white/5 w-fit"><Icon name={u.icon} size={28} /></div>
                <h3 class="text-[15px] font-bold text-cream mb-2">{u.title}</h3>
                <p class="text-[13px] text-muted leading-relaxed">{u.desc}</p>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    {/* UseCases */}
    <section class="px-8 py-20 bg-surface border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>Who Books VO2 Max Testing in Miami</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            Built for Miami athletes and <span class="text-gold">anyone training for the long game</span>
          </h2>
        </FadeIn>
        <div class="grid md:grid-cols-2 gap-5">
          {useCases.map((c, i) => (
            <FadeIn delay={i * 80}>
              <div class="bg-surface-card rounded-2xl p-6 border border-white/10 h-full flex flex-col">
                <h3 class="text-lg font-bold text-cream mb-3">{c.title}</h3>
                <p class="text-[14px] text-muted leading-relaxed flex-grow mb-4">{c.desc}</p>
                <a href={c.href} class="text-[13px] font-semibold text-gold hover:underline">
                  {c.cta}
                </a>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    {/* HowItWorks */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
