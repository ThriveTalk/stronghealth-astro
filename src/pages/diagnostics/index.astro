---
// /diagnostics/ — hub page for Strong Health's diagnostic testing category.
// One section per test (DEXA, VO2 max, RMR, calcium score, MRI) linking every
// live city page.
// The link lists come from src/data/local/diagnosticsConfig.ts — publish a new
// diagnostic city page, register it there, and it shows up here.
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageShell from "../../components/shared/PageShell.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import {
  breadcrumbSchema,
  collectionPageSchema,
  medicalWebPageSchema,
} from "../../components/seo/schemas";
import FadeIn from "../../components/shared/FadeIn.astro";
import Btn from "../../components/shared/Btn.astro";
import Tag from "../../components/shared/Tag.astro";
import Icon from "../../components/shared/Icon.astro";
import { DIAGNOSTIC_CATEGORIES } from "../../data/local/diagnosticsConfig";
import {
  DEXA_CTA_PHONE_DISPLAY,
  DEXA_CTA_PHONE_HREF,
} from "../../data/dexaCta";

const breadcrumbs = [
  { name: "Home", path: "/" },
  { name: "Diagnostics", path: "/diagnostics/" },
];

const liveCategories = DIAGNOSTIC_CATEGORIES.filter((c) => c.locations.length > 0);
const totalLocations = DIAGNOSTIC_CATEGORIES.reduce((n, c) => n + c.locations.length, 0);

const collectionItems = DIAGNOSTIC_CATEGORIES.flatMap((category) =>
  category.locations.map((loc) => ({
    name: `${category.name} ${loc.cityName}, ${loc.state} — Strong Health`,
    url: loc.href,
  }))
);
---

<BaseLayout
  title="Diagnostics — DEXA, VO2, RMR, Calcium & MRI"
  description="Strong Health diagnostic testing by city: DEXA scans, VO2 max, RMR, calcium score tests, and physician-ordered MRI. Find the test and location nearest you."
  path="/diagnostics/"
  smsContext="diagnostic testing"
>
  <PageShell>
    <JsonLd
      schema={medicalWebPageSchema({
        name: "Diagnostics — Strong Health DEXA, VO2 Max, RMR, Calcium Score & MRI Locations",
        description:
          "Hub for Strong Health diagnostic testing: DEXA body composition scans, VO2 max testing, resting metabolic rate (RMR) testing, coronary calcium score tests, and physician-ordered MRI across our locations.",
        url: "/diagnostics/",
        lastReviewed: "2026-08-05",
        reviewedBy: {
          name: "Dr. Angel Rivera, M.D.",
          credentials: "Board-Certified",
          role: "Medical Director — Strong Health",
        },
      })}
    />
    <JsonLd
      schema={collectionPageSchema({
        name: "Strong Health Diagnostic Testing Locations",
        description: "Strong Health diagnostic testing pages by test type and city",
        url: "/diagnostics/",
        items: collectionItems,
      })}
    />
    <JsonLd schema={breadcrumbSchema(breadcrumbs)} />

    {/* Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="px-8 pt-4 pb-0">
      <div class="max-w-[1000px] mx-auto">
        <ol class="flex items-center gap-1.5 text-[12px] text-muted">
          {breadcrumbs.map((crumb, i) => (
            <li class="flex items-center gap-1.5">
              {i > 0 && <Icon name="chevron-right" size={12} class="text-text-subtle" />}
              {i < breadcrumbs.length - 1 ? (
                <a href={crumb.path} class="hover:text-gold transition-colors">
                  {crumb.name}
                </a>
              ) : (
                <span class="text-gold font-semibold">{crumb.name}</span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </nav>

    {/* Hero */}
    <section class="relative px-8 pt-12 pb-20 overflow-hidden border-b border-white/5">
      <div aria-hidden="true" class="hidden md:block absolute top-1/2 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-navy/20 rounded-full blur-[100px] pointer-events-none"></div>
      <div aria-hidden="true" class="hidden md:block absolute bottom-0 right-1/4 translate-x-1/2 translate-y-1/4 w-[500px] h-[500px] bg-gold/10 rounded-full blur-[100px] pointer-events-none"></div>
      <div class="max-w-[1000px] mx-auto relative z-10">
        <Tag>Strong Health · Diagnostics</Tag>
        <h1 class="text-4xl md:text-[52px] font-black text-cream leading-[1.08] mt-6 mb-5 max-w-[760px] tracking-[-1.5px]">
          Diagnostics: <span class="text-gold">measure first,</span> then optimize.
        </h1>
        <p class="text-[17px] text-muted leading-relaxed max-w-[620px] mb-8">
          Body composition, cardiorespiratory fitness, metabolism, heart-disease
          risk, and imaging — the baseline numbers every serious health protocol
          is built on.
          {totalLocations} diagnostic pages across {liveCategories.length} test
          types. Pick your test, then the city nearest you.
        </p>
        <Btn trackLead placement="hero">Book Your Free Assessment →</Btn>
        <div class="mt-4 text-xs text-muted">
          No commitment · No insurance needed · Transparent direct-pay pricing
        </div>
      </div>
    </section>

    {/* Categories */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-12">
          <Tag>Find Your Test</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            Diagnostic testing <span class="text-gold">by category</span>
          </h2>
          <p class="text-[15px] text-muted max-w-[600px] mx-auto">
            Every test is physician-supervised, and the results are reviewed
            with you — not emailed as a PDF and forgotten.
          </p>
        </FadeIn>

        <div class="flex flex-col gap-6">
          {DIAGNOSTIC_CATEGORIES.map((category, i) => (
            <FadeIn delay={i * 60}>
              <div class="bg-surface-raised rounded-2xl p-6 md:p-8 border border-white/10">
                <div class="flex items-start justify-between flex-wrap gap-3 mb-2">
                  <h3 class="text-xl font-bold text-cream flex items-center gap-2.5">
                    <Icon name={category.icon} size={20} class="text-gold shrink-0" />
                    {category.name}
                  </h3>
                  {category.guide && (
                    <a
                      href={category.guide.href}
                      class="text-[12px] font-semibold text-gold hover:text-gold-hover transition-colors"
                    >
                      {category.guide.label} →
                    </a>
                  )}
                </div>
                <p class="text-[14px] text-muted leading-relaxed mb-5 max-w-[680px]">
                  {category.tagline}
                </p>
                {category.locations.length > 0 ? (
                  <div class="flex flex-wrap gap-2.5">
                    {category.locations.map((loc) => (
                      <a
                        href={loc.href}
                        class="inline-flex items-center gap-1.5 rounded-lg border border-white/10 bg-surface-card/60 px-3.5 py-2 text-[12px] font-semibold text-cream hover:border-gold/40 hover:text-gold transition-colors"
                      >
                        <Icon name="map-pin" size={12} class="text-gold shrink-0" />
                        {category.name} {loc.cityName}, {loc.state}
                      </a>
                    ))}
                  </div>
                ) : (
                  <p class="text-[13px] text-muted italic">
                    Coming soon — call{" "}
                    <a href={DEXA_CTA_PHONE_HREF} class="text-gold font-semibold not-italic hover:underline">
                      {DEXA_CTA_PHONE_DISPLAY}
                    </a>{" "}
                    to ask about availability at our Miami (Brickell) clinic.
                  </p>
                )}
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    {/* Final CTA */}
    <section class="px-8 py-24 bg-gradient-to-br from-[#C9A84C]/[0.08] to-[#0D0F12] border-b border-white/5">
      <div class="max-w-[700px] mx-auto text-center">
        <FadeIn>
          <h2 class="text-[36px] font-black text-cream leading-[1.1] mb-4">
            Not sure which test to start with?
          </h2>
          <p class="text-[17px] text-muted leading-relaxed mb-8 max-w-[520px] mx-auto">
            Most patients start with a DEXA scan for a full body-composition
            baseline. Book a free assessment and a physician will map out which
            diagnostics actually matter for your goals.
          </p>
          <div class="flex items-center justify-center gap-2 mb-6 text-[13px] text-muted">
            <Icon name="phone" size={14} class="text-gold" />
            <a href={DEXA_CTA_PHONE_HREF} class="hover:text-gold transition-colors">
              Or call {DEXA_CTA_PHONE_DISPLAY}
            </a>
          </div>
          <Btn trackLead placement="final_cta">Book Your Free Assessment →</Btn>
        </FadeIn>
      </div>
    </section>
  </PageShell>
</BaseLayout>
