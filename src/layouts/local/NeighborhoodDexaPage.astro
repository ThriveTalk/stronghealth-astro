---
/**
 * Neighborhood-level DEXA landing page
 * (`/{statePrefix}/{citySlug}/dexascan/{slug}/`), nested under a city hub
 * with a physical clinic (Option A structure). City-agnostic by design:
 * validated with Miami first, then expanded to other metros by adding a new
 * DexaNeighborhoodCity config + one dynamic route file — this layout never
 * hard-codes a city.
 *
 * Anti-doorway rule: every localized block (hero intro, getting-here,
 * why-local, FAQs, testimonial) renders from the neighborhood config; only
 * DEXA education sections (report contents, how-it-works) are shared.
 */
import BaseLayout from "../BaseLayout.astro";
import PageShell from "../../components/shared/PageShell.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import {
  articleSchema,
  breadcrumbSchema,
  faqPageSchema,
  medicalWebPageSchema,
} from "../../components/seo/schemas";
import FadeIn from "../../components/shared/FadeIn.astro";
import Btn from "../../components/shared/Btn.astro";
import Tag from "../../components/shared/Tag.astro";
import Icon from "../../components/shared/Icon.astro";
import AuthorByline from "../../components/shared/AuthorByline.astro";
import FAQSection from "../../components/shared/FAQSection.astro";
import { MAHADEV_MUKHERJEE, DR_ANGEL_RIVERA } from "../../data/articleAuthors";
import type {
  DexaNeighborhoodCity,
  DexaNeighborhoodConfig,
} from "../../data/local/dexaNeighborhoods";
import {
  DEXA_BOOKING_SMS_HREF,
  DEXA_CTA_PHONE_DISPLAY,
  DEXA_CTA_PHONE_HREF,
} from "../../data/dexaCta";

interface Props {
  city: DexaNeighborhoodCity;
  hood: DexaNeighborhoodConfig;
}

const { city, hood } = Astro.props;

const PUBLISH_DATE = "2026-08-02";
const SITE_URL = "https://www.stronghealth.com";

const clinic = city.clinic;
const clinicArea = city.clinicArea;
const pagePath = `${city.hubPath}${hood.slug}/`;
const FULL_ADDRESS = `${clinic.streetAddress}, ${clinic.city}, ${clinic.state} ${clinic.postalCode}`;
const MAPS_QUERY = encodeURIComponent(`${clinic.name}, ${FULL_ADDRESS}`);
// DEXA pages call and text their own tracked line (see src/data/dexaCta.ts),
// not clinic.phoneTel — that stays the clinic NAP used by schema.
const CTA_PHONE = DEXA_CTA_PHONE_DISPLAY;
const TEL_HREF = DEXA_CTA_PHONE_HREF;
const BOOKING_SMS_HREF = DEXA_BOOKING_SMS_HREF;

// "Downtown Miami — Miami" reads badly; drop the city suffix when the
// neighborhood name already contains it. Title budget: check-seo enforces
// ≤60 chars including " | Strong Health".
const nameHasCity = hood.name.includes(city.cityName);
const seoTitle = nameHasCity
  ? `DEXA Scan Near ${hood.name}`
  : `DEXA Scan Near ${hood.name} — ${city.cityName}`;
const seoDescription = nameHasCity
  ? `DEXA scan near ${hood.name} — just ${hood.driveTime} from our ${clinicArea} clinic. Body fat %, lean mass, visceral fat & bone density. Walk-ins welcome.`
  : `DEXA scan near ${hood.name}, ${city.cityName} — just ${hood.driveTime} from our ${clinicArea} clinic. Body fat %, lean mass, visceral fat & bone density. Walk-ins welcome.`;
const jsonLdDescription = `Physician-supervised DEXA scan body composition analysis for ${hood.name} patients at Strong Health's ${clinicArea} clinic, ${hood.driveTime} away. Lean mass, body fat percentage, visceral fat, and bone density.`;

const breadcrumbs = [
  { name: "Home", path: "/" },
  ...(city.stateHubPath ? [{ name: city.stateName, path: city.stateHubPath }] : []),
  { name: `DEXA Scan ${city.cityName}`, path: city.hubPath },
  { name: hood.name, path: pagePath },
];

const nearbyHoods = hood.nearby
  .map((slug) => city.neighborhoods.find((h) => h.slug === slug))
  .filter((h): h is DexaNeighborhoodConfig => Boolean(h));

// Full interlink mesh: every neighborhood page links every sibling — the
// adjacent ones as featured cards, the rest as a compact link cloud.
const otherHoods = city.neighborhoods.filter(
  (h) => h.slug !== hood.slug && !hood.nearby.includes(h.slug),
);

// FAQ set is deliberately neighborhood-only (plus one parameterized pricing
// question): the generic science/prep/safety questions live on the city hub
// and /dexa-scan/ guide, so the hub — not 17 children — ranks for citywide
// and informational queries, and the children never emit near-duplicate
// FAQPage schema against each other.
const FAQS = [
  ...hood.faqs,
  {
    question: `How much does a DEXA scan cost for ${hood.name} patients?`,
    answer: `The same transparent direct-pay pricing as every Strong Health scan: most patients pay under $200 per body composition scan, with bundled pricing available if you plan to track progress across multiple scans per year. No referral or insurance is needed. Bone density DEXA scans (for osteoporosis screening) may be covered by insurance for eligible patients.`,
  },
];

const whyDexaPoints = [
  { icon: "chart-line", text: "1–2% margin of error vs. 5–8% for BIA scales" },
  { icon: "activity", text: "Region-by-region breakdown (arms, legs, trunk)" },
  { icon: "bone", text: "Bone density scoring (T-score, Z-score)" },
  { icon: "scale", text: "Visceral fat measurement, not just total body fat" },
  { icon: "heart-pulse", text: "FDA-approved, low-dose, repeatable for trend data" },
];

const steps = [
  {
    num: "01",
    title: "Book Your Scan",
    desc: `Reserve online or call ${CTA_PHONE}. Our ${clinicArea} clinic is ${hood.driveTime} from ${hood.name}, and same-week appointments are typically available.`,
    color: "#C9A84C",
  },
  {
    num: "02",
    title: "10–15 Minute Scan",
    desc: "Lie flat on an open table while the scanner arm passes over you. No injections, no enclosed space, ultra-low radiation.",
    color: "#5DADE2",
  },
  {
    num: "03",
    title: "Get Your Detailed Report",
    desc: "Full PDF report within 24 hours: lean mass, body fat % by region, visceral fat, bone density, symmetry analysis.",
    color: "#34D399",
  },
  {
    num: "04",
    title: "Track Progress Over Time",
    desc: "Re-scan every 3–6 months on active protocols. Side-by-side trend reports show what's actually changing.",
    color: "#D4B96A",
  },
];

// One MedicalBusiness node per page: same physical clinic (branchOf the
// canonical clinic @id — never a fake second location), with areaServed
// narrowed to this neighborhood and its ZIP codes.
const medicalClinicSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": `${SITE_URL}${pagePath}#clinic`,
  name: `${clinic.name} — DEXA Scan`,
  url: `${SITE_URL}${pagePath}`,
  telephone: clinic.phoneTel,
  image: `${SITE_URL}/opengraph.jpg`,
  parentOrganization: { "@id": `${SITE_URL}/#organization` },
  branchOf: { "@id": clinic.schemaId },
  address: {
    "@type": "PostalAddress",
    streetAddress: clinic.streetAddress,
    addressLocality: clinic.city,
    addressRegion: clinic.state,
    postalCode: clinic.postalCode,
    addressCountry: "US",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: clinic.lat,
    longitude: clinic.lng,
  },
  areaServed: [
    {
      "@type": "Place",
      name: `${hood.name}, ${city.cityName}, ${city.stateAbbr}`,
    },
    ...hood.zips,
  ],
  medicalSpecialty: ["DiagnosticRadiology", "PreventiveMedicine"],
  availableService: [
    {
      "@type": "MedicalProcedure",
      name: "DEXA Scan — Body Composition Analysis",
      procedureType: "https://schema.org/DiagnosticProcedure",
      description:
        "Dual-Energy X-ray Absorptiometry scan for precise measurement of lean mass, body fat percentage, visceral adipose tissue, and bone mineral density.",
    },
    {
      "@type": "MedicalProcedure",
      name: "DEXA Scan — Bone Density",
      procedureType: "https://schema.org/DiagnosticProcedure",
      description:
        "Bone mineral density scanning (T-score and Z-score) for osteopenia and osteoporosis screening.",
    },
  ],
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: clinic.hoursWeekday.opens,
      closes: clinic.hoursWeekday.closes,
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday"],
      opens: clinic.hoursSaturday.opens,
      closes: clinic.hoursSaturday.closes,
    },
  ],
  priceRange: "$",
};
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  path={pagePath}
  smsContext={`DEXA scans near ${hood.name}`}
>
  <PageShell>
    <JsonLd schema={medicalClinicSchema} />
    <JsonLd
      schema={medicalWebPageSchema({
        name: seoTitle,
        description: jsonLdDescription,
        url: pagePath,
        lastReviewed: PUBLISH_DATE,
        reviewedBy: DR_ANGEL_RIVERA,
      })}
    />
    <JsonLd
      schema={articleSchema({
        headline: `DEXA Scan Near ${hood.name} — Body Composition & Bone Density`,
        description: jsonLdDescription,
        author: MAHADEV_MUKHERJEE,
        reviewer: DR_ANGEL_RIVERA,
        publishDate: PUBLISH_DATE,
        updatedDate: PUBLISH_DATE,
        url: pagePath,
      })}
    />
    <JsonLd schema={faqPageSchema(FAQS)} />
    <JsonLd schema={breadcrumbSchema(breadcrumbs)} />

    {/* Breadcrumbs */}
    <nav aria-label="Breadcrumb" class="px-8 pt-4 pb-0">
      <div class="max-w-[1000px] mx-auto">
        <ol class="flex items-center gap-1.5 text-[12px] text-muted flex-wrap">
          {breadcrumbs.map((crumb, i) => {
            const isLast = i === breadcrumbs.length - 1;
            return (
              <li class="flex items-center gap-1.5">
                {i > 0 && <Icon name="chevron-right" size={12} class="text-text-subtle" />}
                {isLast ? (
                  <span class="text-gold font-semibold">{crumb.name}</span>
                ) : (
                  <a href={crumb.path} class="hover:text-gold transition-colors">
                    {crumb.name}
                  </a>
                )}
              </li>
            );
          })}
        </ol>
      </div>
    </nav>

    {/* Hero */}
    <section class="relative px-8 pt-12 pb-24 overflow-hidden border-b border-white/5">
      <div aria-hidden="true" class="hidden md:block absolute top-1/2 left-1/4 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-navy/20 rounded-full blur-[100px] pointer-events-none"></div>
      <div aria-hidden="true" class="hidden md:block absolute bottom-0 right-1/4 translate-x-1/2 translate-y-1/4 w-[500px] h-[500px] bg-gold/10 rounded-full blur-[100px] pointer-events-none"></div>

      <div class="max-w-[1000px] mx-auto relative z-10">
        <div class="flex items-center gap-2.5 mb-5">
          <div class="flex gap-0.5">
            {[1, 2, 3, 4, 5].map(() => <Icon name="star" size={16} class="fill-[#C9A84C] text-gold" />)}
          </div>
          <span class="text-sm font-bold text-gold">4.9</span>
          <span class="text-[13px] text-muted">from 850+ {city.cityName} patient reviews</span>
        </div>

        <Tag>{hood.name} · {hood.driveTime} from our {clinicArea} clinic · Walk-Ins Welcome</Tag>

        <h1 class="text-4xl md:text-[52px] font-black text-cream leading-[1.08] mt-6 mb-5 max-w-[760px] tracking-[-1.5px]">
          DEXA Scan Near {hood.name}. <span class="text-gold">Gold-standard body composition, {hood.driveTime} away.</span>
        </h1>

        <p class="text-[17px] text-muted leading-relaxed max-w-[640px] mb-8">
          {hood.intro}
        </p>

        <Btn trackLead placement="hero" href={BOOKING_SMS_HREF}>Book Your DEXA Scan →</Btn>
        <div class="mt-4 text-xs text-muted">
          15–20 min visit · Same-week appointments · No referral needed
        </div>
      </div>
    </section>

    {/* Byline */}
    <section class="px-8 pt-2 pb-6 bg-surface">
      <div class="max-w-[800px] mx-auto">
        <AuthorByline
          author={MAHADEV_MUKHERJEE}
          reviewer={DR_ANGEL_RIVERA}
          publishDate={PUBLISH_DATE}
        />
      </div>
    </section>

    {/* GettingHere — the core localization block */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>Getting Here from {hood.name}</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            {hood.name} to <span class="text-gold">{clinic.streetAddress}</span>
          </h2>
          <p class="text-[15px] text-muted max-w-[560px] mx-auto">
            Our {clinicArea} clinic is {hood.distance} from {hood.name}, about {hood.driveTime} door
            to door. Serving ZIP {hood.zips.length > 1 ? "codes" : "code"} {hood.zips.join(", ")}.
          </p>
        </FadeIn>

        <div class="grid md:grid-cols-2 gap-6">
          <FadeIn>
            <div class="bg-surface rounded-2xl border border-white/10 overflow-hidden h-full">
              <iframe
                src={`https://maps.google.com/maps?q=${MAPS_QUERY}&output=embed`}
                class="w-full h-[240px] border-0"
                allowfullscreen
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title={`${clinic.name} - ${clinic.streetAddress}`}
              ></iframe>
              <div class="p-6 flex flex-col gap-4">
                <div class="flex items-start gap-3">
                  <Icon name="map-pin" size={16} class="text-gold shrink-0 mt-0.5" />
                  <div>
                    <div class="text-sm font-bold text-cream">{clinic.name}</div>
                    <div class="text-sm text-cream-muted mt-0.5">{FULL_ADDRESS}</div>
                  </div>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="phone" size={16} class="text-gold shrink-0 mt-0.5" />
                  <a href={TEL_HREF} class="text-sm text-cream-muted hover:text-gold transition-colors">
                    {CTA_PHONE}
                  </a>
                </div>
                <div class="flex items-start gap-3">
                  <Icon name="clock" size={16} class="text-gold shrink-0 mt-0.5" />
                  <div class="text-sm text-cream-muted">{clinic.hours}</div>
                </div>
              </div>
            </div>
          </FadeIn>

          <FadeIn delay={200}>
            <div class="flex flex-col gap-4 h-full">
              <div class="bg-surface rounded-2xl border border-white/10 p-6">
                <div class="flex items-center gap-2.5 mb-2">
                  <Icon name="navigation" size={16} class="text-gold" />
                  <h3 class="text-[15px] font-bold text-cream">Driving from {hood.name}</h3>
                </div>
                <p class="text-[13px] text-muted leading-[1.7]">{hood.route}</p>
              </div>
              <div class="bg-surface rounded-2xl border border-white/10 p-6">
                <div class="flex items-center gap-2.5 mb-2">
                  <Icon name="activity" size={16} class="text-gold" />
                  <h3 class="text-[15px] font-bold text-cream">Without a car</h3>
                </div>
                <p class="text-[13px] text-muted leading-[1.7]">{hood.transit}</p>
              </div>
              <div class="bg-surface rounded-2xl border border-white/10 p-6">
                <div class="flex items-center gap-2.5 mb-2">
                  <Icon name="clipboard-check" size={16} class="text-gold" />
                  <h3 class="text-[15px] font-bold text-cream">Local tip</h3>
                </div>
                <p class="text-[13px] text-muted leading-[1.7]">{hood.localTip}</p>
              </div>
            </div>
          </FadeIn>
        </div>

        <FadeIn delay={250}>
          <div class="mt-8 text-center">
            <div class="text-[12px] text-muted uppercase tracking-wider font-semibold mb-3">
              Minutes from
            </div>
            <div class="flex flex-wrap gap-2 justify-center max-w-[720px] mx-auto">
              {hood.landmarks.map((l) => (
                <span class="text-[12px] text-cream-muted bg-surface-raised border border-white/10 rounded-full px-3.5 py-1.5">
                  {l}
                </span>
              ))}
            </div>
          </div>
        </FadeIn>
      </div>
    </section>

    {/* WhyDexa — localized lead paragraph */}
    <section class="px-8 py-20 bg-surface border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <div class="grid md:grid-cols-2 gap-12 items-center">
          <FadeIn>
            <Tag>Why DEXA for {hood.name}</Tag>
            <h2 class="text-[32px] font-extrabold text-cream leading-[1.15] mt-4 mb-4">
              The scale lies. <span class="text-gold">DEXA tells the truth.</span>
            </h2>
            <p class="text-[15px] text-muted leading-[1.7] mb-4">{hood.whyLocal}</p>
            <p class="text-[15px] text-muted leading-[1.7]">
              At {clinic.name}, you get the same scan technology used in clinical research,
              performed at our {clinicArea} clinic, with results you can use to track real
              progress on TRT, GLP-1 weight loss, peptide therapy, or your own training.
            </p>
          </FadeIn>

          <FadeIn delay={200}>
            <div class="flex flex-col gap-3.5">
              {whyDexaPoints.map((s) => (
                <div class="flex items-center gap-3 bg-surface-raised rounded-xl p-4 border border-white/5">
                  <div class="w-9 h-9 rounded-full bg-surface flex items-center justify-center shrink-0 border border-white/5">
                    <Icon name={s.icon} size={18} class="text-gold" />
                  </div>
                  <span class="text-sm text-cream-muted">{s.text}</span>
                </div>
              ))}
            </div>
          </FadeIn>
        </div>
      </div>
    </section>

    {/* Report pointer — full report breakdown lives on the city hub, so the
        hub stays the canonical citywide page and the children stay local. */}
    <section class="px-8 py-14 bg-surface-card border-b border-white/5">
      <div class="max-w-[800px] mx-auto text-center">
        <FadeIn>
          <p class="text-[15px] text-muted leading-[1.8]">
            Every scan includes total and regional body fat, pound-precise lean mass by limb,
            visceral fat, bone density (T-score and Z-score), and left-right symmetry analysis.
            See the full report breakdown on the{" "}
            <a href={city.hubPath} class="text-gold hover:underline">DEXA Scan {city.cityName}</a> page,
            or the science behind it in our{" "}
            <a href="/dexa-scan/" class="text-gold hover:underline">complete DEXA guide</a>.
          </p>
        </FadeIn>
      </div>
    </section>

    {/* HowItWorks */}
    <section class="px-8 py-20 bg-surface border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-10">
          <Tag>How It Works</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            Four steps. <span class="text-gold">Real data.</span>
          </h2>
        </FadeIn>

        <div class="grid md:grid-cols-4 gap-4">
          {steps.map((s, i) => (
            <FadeIn delay={i * 100}>
              <div
                class="bg-surface-card rounded-[14px] p-6 border border-white/10 h-full hover:border-white/20 transition-colors"
                style={`border-top:3px solid ${s.color}`}
              >
                <div class="text-[28px] font-black mb-3" style={`color:${s.color}`}>{s.num}</div>
                <h3 class="text-base font-bold text-cream mb-3">{s.title}</h3>
                <p class="text-[13px] text-muted leading-relaxed">{s.desc}</p>
              </div>
            </FadeIn>
          ))}
        </div>
      </div>
    </section>

    {/* Testimonial — single localized quote */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[760px] mx-auto">
        <FadeIn class="text-center mb-8">
          <Tag>{hood.name} Patient Review</Tag>
        </FadeIn>
        <FadeIn delay={100}>
          <div class="bg-surface rounded-2xl p-8 border border-white/10">
            <div class="flex items-center gap-2 mb-4 justify-center">
              <div class="flex gap-0.5">
                {Array.from({ length: 5 }).map(() => (
                  <Icon name="star" size={14} class="fill-[#C9A84C] text-gold" />
                ))}
              </div>
              <span class="text-[10px] text-muted uppercase tracking-wider font-semibold">Verified Patient</span>
            </div>
            <Icon name="quote" size={24} class="text-gold/30 mb-3 mx-auto" />
            <p class="text-[15px] text-cream-muted leading-[1.8] text-center mb-6">{hood.testimonial.text}</p>
            <div class="flex items-center gap-3 justify-center">
              <div class="w-9 h-9 rounded-full bg-gold/10 flex items-center justify-center">
                <span class="text-[12px] font-bold text-gold">{hood.testimonial.name[0]}</span>
              </div>
              <div>
                <div class="text-sm font-semibold text-cream">{hood.testimonial.name}</div>
                <div class="text-[11px] text-muted">{hood.name}, {city.cityName}</div>
              </div>
            </div>
          </div>
        </FadeIn>
      </div>
    </section>

    {/* Nearby neighborhoods + hub */}
    <section class="px-8 py-20 bg-surface border-b border-white/5">
      <div class="max-w-[1000px] mx-auto">
        <FadeIn class="text-center mb-8">
          <Tag>Nearby Neighborhoods</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            DEXA scans near <span class="text-gold">{hood.name}</span>
          </h2>
          <p class="text-[15px] text-muted max-w-[540px] mx-auto">
            One clinic serves all of {city.cityName} — find the guide for your neighborhood.
          </p>
        </FadeIn>
        <FadeIn delay={100}>
          <div class="grid sm:grid-cols-3 gap-4">
            {nearbyHoods.map((n) => (
              <a
                href={`${city.hubPath}${n.slug}/`}
                class="bg-surface-card rounded-xl p-5 border border-white/10 hover:border-gold/40 transition-colors block"
              >
                <div class="text-[15px] font-bold text-cream mb-1">{n.name}</div>
                <div class="text-[12px] text-muted">{n.driveTime} from our clinic →</div>
              </a>
            ))}
          </div>
          <div class="mt-8 text-center">
            <div class="text-[12px] text-muted uppercase tracking-wider font-semibold mb-3">
              All {city.cityName} neighborhoods we serve
            </div>
            <div class="flex flex-wrap gap-2 justify-center max-w-[820px] mx-auto">
              {otherHoods.map((n) => (
                <a
                  href={`${city.hubPath}${n.slug}/`}
                  class="text-[12px] text-cream-muted bg-surface-card border border-white/10 rounded-full px-3.5 py-1.5 hover:border-gold/40 hover:text-gold transition-colors"
                >
                  {n.name}
                </a>
              ))}
            </div>
          </div>
          <p class="text-[13px] text-muted text-center mt-6">
            One clinic, every neighborhood: start from the{" "}
            <a href={city.hubPath} class="text-gold hover:underline">DEXA Scan {city.cityName}</a> hub,
            or read the science in our <a href="/dexa-scan/" class="text-gold hover:underline">full DEXA guide</a>.
          </p>
        </FadeIn>
      </div>
    </section>

    {/* FAQ */}
    <section class="px-8 py-20 bg-surface-card border-b border-white/5">
      <div class="max-w-[800px] mx-auto">
        <FadeIn class="text-center mb-4">
          <Tag>{hood.name} DEXA FAQs</Tag>
          <h2 class="text-[34px] font-extrabold text-cream mt-4 mb-3">
            DEXA scan questions from <span class="text-gold">{hood.name}</span>
          </h2>
        </FadeIn>
        <FAQSection items={FAQS} />
        <FadeIn delay={300}>
          <p class="text-[13px] text-muted text-center mt-4">
            General questions — what the scan measures, how to prepare, safety — are answered on
            the <a href={city.hubPath} class="text-gold hover:underline">DEXA Scan {city.cityName}</a> page
            and in our <a href="/dexa-scan/" class="text-gold hover:underline">full DEXA guide</a>.
          </p>
        </FadeIn>
      </div>
    </section>

    {/* FinalCTA */}
    <section class="px-8 py-24 bg-gradient-to-br from-[#C9A84C]/[0.08] to-[#0D0F12] border-b border-white/5">
      <div class="max-w-[700px] mx-auto text-center">
        <FadeIn>
          <h2 class="text-[36px] font-black text-cream leading-[1.1] mb-4">
            Book your DEXA scan near {hood.name}
          </h2>
          <p class="text-[17px] text-muted leading-relaxed mb-8 max-w-[540px] mx-auto">
            {hood.driveTime} from {hood.name} to the most accurate body composition test
            in {city.cityName}. 15 minutes on the table. No referral needed. Detailed report
            within 24 hours.
          </p>
          <div class="flex items-center justify-center gap-2 mb-6 text-[13px] text-muted">
            <Icon name="phone" size={14} class="text-gold" />
            <a href={TEL_HREF} class="hover:text-gold transition-colors">
              {CTA_PHONE}
            </a>
          </div>
          <Btn trackLead placement="final_cta" href={BOOKING_SMS_HREF}>Book Your DEXA Scan →</Btn>
        </FadeIn>
      </div>
    </section>
  </PageShell>
</BaseLayout>
